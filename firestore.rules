rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{playerId} {
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if request.auth != null
                          && resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
    }
    match /milestones/{milestoneId} {
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow read: if request.auth != null
                  && resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /usage_events/{eventId} {
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.eventType in [
                      'page_launch',
                      'player_login_play',
                      'game_start'
                    ]
                    && request.resource.data.gameVersion is string
                    && request.resource.data.occurredAt == request.time;
      allow read, update, delete: if false;
    }

    match /public_activity_events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.eventType in [
                      'page_launch',
                      'player_login_play',
                      'game_start'
                    ]
                    && request.resource.data.bucket is string
                    && request.resource.data.bucket.size() <= 48
                    && (
                      !('actorKey' in request.resource.data)
                      || (
                        request.resource.data.actorKey is string
                        && request.resource.data.actorKey.size() <= 64
                      )
                    )
                    && request.resource.data.gameVersion is string
                    && request.resource.data.occurredAt == request.time;
      allow update, delete: if false;
    }

    match /game_session_summaries/{summaryId} {
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.actorKey is string
                    && request.resource.data.actorKey.size() <= 64
                    && request.resource.data.gameStarts is int
                    && request.resource.data.gameStarts >= 0
                    && request.resource.data.gameStarts <= 20
                    && request.resource.data.clearedLines is int
                    && request.resource.data.clearedLines >= 0
                    && request.resource.data.clearedLines <= 5000
                    && request.resource.data.levelClears is int
                    && request.resource.data.levelClears >= 0
                    && request.resource.data.levelClears <= 500
                    && (
                      request.resource.data.gameStarts > 0
                      || request.resource.data.clearedLines > 0
                      || request.resource.data.levelClears > 0
                    )
                    && request.resource.data.gameVersion is string
                    && request.resource.data.submittedAt == request.time;
      allow read, update, delete: if false;
    }

    match /public_session_summaries/{summaryId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.actorKey is string
                    && request.resource.data.actorKey.size() <= 64
                    && request.resource.data.gameStarts is int
                    && request.resource.data.gameStarts >= 0
                    && request.resource.data.gameStarts <= 20
                    && request.resource.data.clearedLines is int
                    && request.resource.data.clearedLines >= 0
                    && request.resource.data.clearedLines <= 5000
                    && request.resource.data.levelClears is int
                    && request.resource.data.levelClears >= 0
                    && request.resource.data.levelClears <= 500
                    && (
                      request.resource.data.gameStarts > 0
                      || request.resource.data.clearedLines > 0
                      || request.resource.data.levelClears > 0
                    )
                    && request.resource.data.gameVersion is string
                    && request.resource.data.submittedAt == request.time;
      allow update, delete: if false;
    }

    match /public_player_markers/{markerId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.markerType == 'registered_player'
                    && request.resource.data.gameVersion is string
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /public_milestone10_markers/{markerId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.markerType == 'milestone_10'
                    && request.resource.data.gameVersion is string
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /public_milestone20_markers/{markerId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.markerType == 'milestone_20'
                    && request.resource.data.gameVersion is string
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /public_milestone30_markers/{markerId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.markerType == 'milestone_30'
                    && request.resource.data.gameVersion is string
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }


    match /world_cup_submissions/{submissionId} {
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.submissionId is string
                    && request.resource.data.submissionId == submissionId
                    && request.resource.data.nickname is string
                    && request.resource.data.nickname.size() >= 1
                    && request.resource.data.nickname.size() <= 24
                    && request.resource.data.avatar is string
                    && request.resource.data.avatar.size() <= 16
                    && request.resource.data.color is string
                    && request.resource.data.color.size() <= 32
                    && request.resource.data.bestScore is int
                    && request.resource.data.bestScore > 0
                    && request.resource.data.bestScore <= 2147483647
                    && request.resource.data.highestLevel is int
                    && request.resource.data.highestLevel >= 1
                    && request.resource.data.highestLevel <= 9999
                    && request.resource.data.lines is int
                    && request.resource.data.lines >= 0
                    && request.resource.data.lines <= 999999
                    && request.resource.data.updatedAt == request.time;

      // 同一筆最高分送件可安全重試，但不得更換擁有者、玩家或成績。
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.localPlayerId == resource.data.localPlayerId
                    && request.resource.data.bestScore == resource.data.bestScore
                    && request.resource.data.highestLevel == resource.data.highestLevel
                    && request.resource.data.lines == resource.data.lines
                    && request.resource.data.achievedAtLocal == resource.data.achievedAtLocal
                    && request.resource.data.updatedAt == request.time;

      allow read, delete: if false;
    }

    match /world_cup_candidates/{deviceUid} {
      allow create: if request.auth != null
                    && deviceUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.nickname is string
                    && request.resource.data.nickname.size() >= 1
                    && request.resource.data.nickname.size() <= 24
                    && request.resource.data.avatar is string
                    && request.resource.data.avatar.size() <= 16
                    && request.resource.data.color is string
                    && request.resource.data.color.size() <= 32
                    && request.resource.data.bestScore is int
                    && request.resource.data.bestScore > 0
                    && request.resource.data.bestScore <= 2147483647
                    && request.resource.data.highestLevel is int
                    && request.resource.data.highestLevel >= 1
                    && request.resource.data.highestLevel <= 9999
                    && request.resource.data.lines is int
                    && request.resource.data.lines >= 0
                    && request.resource.data.lines <= 999999
                    && request.resource.data.updatedAt == request.time;

      allow update: if request.auth != null
                    && deviceUid == request.auth.uid
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.bestScore is int
                    && request.resource.data.bestScore >= resource.data.bestScore
                    && request.resource.data.bestScore <= 2147483647
                    && request.resource.data.highestLevel is int
                    && request.resource.data.highestLevel >= 1
                    && request.resource.data.highestLevel <= 9999
                    && request.resource.data.lines is int
                    && request.resource.data.lines >= 0
                    && request.resource.data.lines <= 999999
                    && request.resource.data.updatedAt == request.time;

      allow read: if request.auth != null
                  && deviceUid == request.auth.uid
                  && resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    function ownWorldCupCandidate() {
      return get(/databases/$(database)/documents/world_cup_candidates/$(request.auth.uid)).data;
    }

    function championMatchesOwnCandidate() {
      let candidate = ownWorldCupCandidate();
      let champion = request.resource.data.champion;
      return champion.nickname == candidate.nickname
             && champion.avatar == candidate.avatar
             && champion.color == candidate.color
             && champion.bestScore == candidate.bestScore
             && champion.highestLevel == candidate.highestLevel
             && champion.lines == candidate.lines;
    }

    function ownWorldCupSubmission() {
      return get(/databases/$(database)/documents/world_cup_submissions/$(request.resource.data.submissionId)).data;
    }

    function championMatchesOwnSubmission() {
      let submission = ownWorldCupSubmission();
      let champion = request.resource.data.champion;
      return request.resource.data.submissionId is string
             && request.resource.data.submissionId.size() > 0
             && exists(/databases/$(database)/documents/world_cup_submissions/$(request.resource.data.submissionId))
             && submission.ownerUid == request.auth.uid
             && champion.nickname == submission.nickname
             && champion.avatar == submission.avatar
             && champion.color == submission.color
             && champion.bestScore == submission.bestScore
             && champion.highestLevel == submission.highestLevel
             && champion.lines == submission.lines;
    }

    function championHasTrustedProof() {
      return (
        exists(/databases/$(database)/documents/world_cup_candidates/$(request.auth.uid))
        && championMatchesOwnCandidate()
      ) || championMatchesOwnSubmission();
    }

    function candidateOutranksCurrent() {
      let next = request.resource.data.champion;
      let current = resource.data.champion;
      return current == null
             || next.bestScore > current.bestScore
             || (next.bestScore == current.bestScore
                 && next.highestLevel > current.highestLevel)
             || (next.bestScore == current.bestScore
                 && next.highestLevel == current.highestLevel
                 && next.lines > current.lines);
    }

    match /world_cup/{documentId} {
      allow read: if true;

      allow create: if documentId == 'current'
                    && request.auth != null
                    && championHasTrustedProof()
                    && request.resource.data.updatedAt == request.time;

      allow update: if documentId == 'current'
                    && request.auth != null
                    && championHasTrustedProof()
                    && candidateOutranksCurrent()
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['title', 'champion', 'submissionId', 'updatedAt', 'gameVersion']);

      allow delete: if false;
    }

    match /public_stats/{documentId} {
      allow read: if true;
      allow write: if false;
    }
    match /leaderboard/{playerId} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
